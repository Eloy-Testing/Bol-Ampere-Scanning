/debug*.jsonl
/*.debug.jsonl

# Generated timestamped HTML revisions (retain /index.html)
/[0-9]*.html

# Root screenshots and thumbnails (verification/ remains eligible for version control)
/screenshot*.png
/thumbnail*.png
/screenshots/

# Dependencies and Playwright artifacts
node_modules/
/playwright-report/
/test-results/
/blob-report/
/.playwright/
/.vercel/
*.trace.zip

# Runtime secrets and local databases
.env
.env.*
!.env.example
.data/
*.db
*.db-shm
*.db-wal

# OS junk
.DS_Store
Thumbs.db
